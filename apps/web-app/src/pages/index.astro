---
import FullScreenMap from "@/features/map/react/FullScreenMap";
import AppLayout from "@/features/core/AppLayout.svelte";
import "../index.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Jumpa - Premium Spatial Matching</title>
    <meta
      name="description"
      content="Wayland-grade fluid spatial matching application using high-performance WebGL maps."
    />
    <script is:inline>
      function showErrorOverlay(title, message, color) {
        if (!message || !message.trim()) return;

        let container = document.getElementById("error-overlay-container");
        if (!container) {
          container = document.createElement("div");
          container.id = "error-overlay-container";
          container.style.position = "fixed";
          container.style.bottom = "20px";
          container.style.left = "20px";
          container.style.right = "20px";
          container.style.display = "flex";
          container.style.flexDirection = "column";
          container.style.gap = "10px";
          container.style.maxHeight = "50vh";
          container.style.overflowY = "auto";
          container.style.zIndex = "999999";
          container.style.pointerEvents = "none";
          document.body.appendChild(container);
        }

        const div = document.createElement("div");
        div.style.pointerEvents = "auto";
        div.style.padding = "15px";
        div.style.background = color;
        div.style.color = "white";
        div.style.fontFamily = "monospace";
        div.style.whiteSpace = "pre-wrap";
        div.style.borderRadius = "8px";
        div.style.boxShadow = "0 10px 25px rgba(0,0,0,0.5)";
        div.style.position = "relative";
        div.style.fontSize = "13px";
        div.style.lineHeight = "1.4";

        const closeBtn = document.createElement("button");
        closeBtn.innerText = "✕";
        closeBtn.style.position = "absolute";
        closeBtn.style.top = "8px";
        closeBtn.style.right = "12px";
        closeBtn.style.background = "none";
        closeBtn.style.border = "none";
        closeBtn.style.color = "white";
        closeBtn.style.fontSize = "16px";
        closeBtn.style.cursor = "pointer";
        closeBtn.style.padding = "4px";
        closeBtn.style.opacity = "0.7";
        closeBtn.onmouseover = () => { closeBtn.style.opacity = "1"; };
        closeBtn.onmouseout = () => { closeBtn.style.opacity = "0.7"; };
        closeBtn.onclick = () => { div.remove(); };

        const content = document.createElement("div");
        content.innerText = `${title}:\n${message}`;
        content.style.paddingRight = "20px";

        div.appendChild(closeBtn);
        div.appendChild(content);
        container.appendChild(div);

        // Auto-scroll to bottom of error container
        container.scrollTop = container.scrollHeight;
      }

      window.addEventListener("error", (event) => {
        const message = event.error ? event.error.stack : event.message;
        showErrorOverlay("Browser Error", message, "#ef4444");
      });

      window.addEventListener("unhandledrejection", (event) => {
        const message = event.reason ? event.reason.stack || event.reason : event;
        showErrorOverlay("Unhandled Rejection", String(message), "#f97316");
      });

      // Override console.error to print Astro hydration errors or import failures
      const originalConsoleError = console.error;
      console.error = function (...args) {
        const errorMsg = args
          .map((arg) => {
            if (arg instanceof Error) return arg.stack;
            if (typeof arg === "object") {
              try {
                return JSON.stringify(arg);
              } catch (e) {
                return String(arg);
              }
            }
            return String(arg);
          })
          .join(" ");

        // Ignore harmless Vite/HMR websocket connection errors that overlay the UI in dev, redirect them to console.log
        if (
          errorMsg.includes("[vite]") ||
          errorMsg.includes("@vite/client") ||
          errorMsg.includes("HMRClient") ||
          errorMsg.includes("AstroDevToolbar") ||
          errorMsg.includes("toolbar-")
        ) {
          console.log(...args);
          return;
        }

        originalConsoleError.apply(console, args);

        showErrorOverlay("Console Error", errorMsg, "#dc2626");
      };
    </script>
  </head>
  <body>
    <div class="app-container">
      <!-- Cosmic backdrop is revealed during the blackhole transition scale-down -->
      <div class="cosmic-backdrop"></div>

      <!-- Viewport wrapper for map -->
      <div id="map-viewport" class="map-viewport-wrapper">
        <FullScreenMap client:only="react" />
      </div>

      <!-- Main Unified Layout Overlay -->
      <AppLayout client:only="svelte" />
    </div>
  </body>
</html>
